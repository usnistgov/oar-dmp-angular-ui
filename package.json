{
    "name": "oar-dmp",
    "workspaces": [
        "lib",
        "oar-dmp"
    ],
    "overrides": {
        "@angular/core": "18.2.14",
        "@angular/common": "18.2.14",
        "@angular/compiler": "18.2.14",
        "@angular/compiler-cli": "18.2.14",
        "@angular/platform-browser": "18.2.14",
        "@angular/platform-browser-dynamic": "18.2.14",
        "@angular/forms": "18.2.14",
        "@angular/router": "18.2.14",
        "@angular/animations": "18.2.14"
    },
    "scripts": {
        "build-lib": "npm run build oarng --prefix ./lib",
        "build-oardmp": "npm run build dmp_ui2 --prefix ./oar-dmp",
        "build-all": "npm run build oarng --prefix ./lib && npm run build dmp_ui2 --prefix ./oar-dmp",
        "start-oardmp": "npm run start dmp_ui2 --prefix ./oar-dmp",
        "test": "jest --config ./oar-dmp/jest.config.js",
        "test:silent": "jest --config ./oar-dmp/jest.config.js --silent"
    },
    "devDependencies": {
        "@types/jest": "^29.5.1",
        "jest": "^29.5.0",
        "jest-preset-angular": "^14.6.2",
        "ts-jest": "^29.1.0"
    }
}
